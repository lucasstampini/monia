{
  "name": "analise-de-gastos",
  "version": "0.1.0",
  "private": true,
  "description": "App desktop pessoal para análise de fatura e gastos",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "dev.lucas.analise-de-gastos",
    "productName": "Análise de Gastos",
    "files": ["out/**", "drizzle/**"],
    "mac": { "category": "public.app-category.finance" }
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "electron": "42.11.15",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
